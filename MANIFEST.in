include LICENSE THIRD_PARTY_NOTICES.md README.md run-local.py run.sh run.ps1
recursive-include licenses *
include packaging/entry.py packaging/build.py packaging/release.py packaging/smoke.py
include packaging/collect_notices.py packaging/requirements-release.txt
include packaging/notices-lock.json CHANGELOG.md
recursive-include packaging/license-data *
recursive-include docs *.md
recursive-include docs/assets *.png
recursive-include tests *.py
prune infra
prune licenses/linux-build
exclude AGENTS.md
exclude docs/analysis-plan.md docs/background-handoff.md docs/reader-observations.md
exclude docs/review.md docs/verification.md
